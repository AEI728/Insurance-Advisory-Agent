{
  "name": "insurance-agent",
  "version": "0.1.0",
  "private": true,
  "description": "安心保保险规划 Agent：规则式咨询前端 + RAG + OpenAI API 适配层",
  "main": "server.js",
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "check": "node scripts/check.js",
    "check:knowledge": "node scripts/validate-knowledge.js",
    "db:migrate": "node scripts/migrate.js",
    "kb:seed": "node scripts/seed-knowledge.js",
    "kb:demo": "node scripts/seed-knowledge.js --demo-fixtures",
    "kb:check": "node scripts/validate-knowledge.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "test:e2e": "playwright test",
    "eval": "node scripts/eval.js --dataset tests/fixtures --out artifacts/eval",
    "ci:verify": "npm run check && npm run test:unit && npm run test:integration && npm run test:e2e && npm run eval",
    "smoke": "node scripts/smoke.js",
    "backup": "node scripts/backup.js"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "openai": "^4.104.0",
    "pdfjs-dist": "^6.5.438",
    "pino": "^10.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "supertest": "^7.3.2"
  },
  "engines": {
    "node": ">=22.16.0"
  }
}
