# 开发阶段默认使用模拟回答；接入 DeepSeek API 前将其改为 false，并填写真实密钥。
USE_MOCK_LLM=true
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
PORT=4312

# 现有知识经 kb:seed 导入 SQLite 后保持 pending；管理员需逐条审核。
# 管理接口为 /api/v1/admin/knowledge/import，旧接口已废弃。
KNOWLEDGE_BASE_PATH=./knowledge-base
RAG_TOP_K=4

# P1 local workflow additions (keep existing DeepSeek settings above)
NODE_ENV=development
HOST=127.0.0.1
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=
DATABASE_PATH=
DATA_ENCRYPTION_KEY=
ADMIN_API_TOKEN=
RAG_BACKEND=lexical
RAG_CANDIDATES=20
RAG_MAX_RETRIEVAL_ATTEMPTS=2
RAG_MAX_CONTEXT_TOKENS=4000
CHUNK_TARGET_TOKENS=600
CHUNK_OVERLAP_TOKENS=90
TOOL_TIMEOUT_MS=5000
LLM_TIMEOUT_MS=15000
TASK_DEADLINE_MS=30000
MAX_AGENT_STEPS=6
MAX_TOOL_RETRIES=2
MAX_CLARIFICATION_TURNS=12
SESSION_TTL_HOURS=24
UPLOAD_MAX_BYTES=5242880
LOG_LEVEL=info
ALLOW_SENSITIVE_UPLOADS=false
HUMAN_HANDOFF_ENABLED=false
ENABLE_DEMO_KNOWLEDGE=false
